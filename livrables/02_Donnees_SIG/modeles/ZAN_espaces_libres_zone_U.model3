    <Option name="ALG_DESC" value="Repère les espaces libres constructibles dans les zones urbaines à dominante habitat du PLUi : parcelles moins le bâti et son recul, moins les prescriptions excluantes (EBC, patrimoine paysager, risques), puis ouverture morphologique pour ne garder que les espaces où un lot de la largeur minimale peut s'inscrire. Version simplifiée de l'étape 4 du diagnostic (sans critère d'accès à la voie ni typologie)." type="QString"/>
    <Option name="largeur_lot" value="Côté du carré qui doit pouvoir s'inscrire dans l'espace libre." type="QString"/>
    <Option name="recul_bati" value="Distance minimale entre un nouveau lot et le bâti existant." type="QString"/>
    <Option name="surface_min" value="Surface en dessous de laquelle un espace libre n'est pas retenu." type="QString"/>
  </Option>
