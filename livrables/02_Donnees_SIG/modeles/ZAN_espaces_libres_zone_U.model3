        <Option type="List" name="EXPRESSION">
          <Option type="Map">
            <Option type="int" name="source" value="2"/>
            <Option type="QString" name="static_value" value="&quot;famille&quot; = 'U' AND regexp_match(&quot;libelle&quot;, '^(UA|UB|UC|UD|UR)') AND left(&quot;libelle&quot;, 3) &lt;> 'URX'"/>
          </Option>
        </Option>
        <Option type="List" name="INPUT">
          <Option type="Map">
            <Option type="QString" name="parameter_name" value="zonage"/>
            <Option type="int" name="source" value="0"/>
          </Option>
        </Option>
      </Option>
